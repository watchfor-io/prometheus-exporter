# HELP watchfor_organization_info Organization metadata (slug, plan). Always 1.
# TYPE watchfor_organization_info gauge
watchfor_organization_info{organization="globex-corp",plan="business"} 1
# HELP watchfor_monitors Monitors by effective status: down = a confirmed critical incident, degraded = a warning incident or an unconfirmed failure. Same rule as the dashboard.
# TYPE watchfor_monitors gauge
watchfor_monitors{status="up"} 1
watchfor_monitors{status="degraded"} 1
watchfor_monitors{status="down"} 0
watchfor_monitors{status="paused"} 0
watchfor_monitors{status="unknown"} 0
# HELP watchfor_health_score Fleet health score 0-100, the same number as the dashboard and GET /v1/summary.
# TYPE watchfor_health_score gauge
watchfor_health_score 95
# HELP watchfor_incidents_firing Firing (unacknowledged) incidents on monitors and hosts, by severity.
# TYPE watchfor_incidents_firing gauge
watchfor_incidents_firing{severity="critical"} 0
watchfor_incidents_firing{severity="warning"} 1
# HELP watchfor_incidents_acknowledged Acknowledged incidents that are still open.
# TYPE watchfor_incidents_acknowledged gauge
watchfor_incidents_acknowledged 1
# HELP watchfor_maintenance_windows_active Maintenance windows in progress right now.
# TYPE watchfor_maintenance_windows_active gauge
watchfor_maintenance_windows_active 1
# HELP watchfor_monitor_info Monitor metadata; join on monitor_id with group_left(name, type). Always 1.
# TYPE watchfor_monitor_info gauge
watchfor_monitor_info{monitor_id="a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c51",name="Checkout",type="playwright",target="https://shop.globex.example/checkout",tags="prod,shop",strategy="roundrobin"} 1
watchfor_monitor_info{monitor_id="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d61",name="DNS",type="dns",target="globex.example",tags="prod",strategy="all"} 1
# HELP watchfor_monitor_up 1 unless a confirmed critical incident is open on the monitor (degraded counts as up). Absent while paused. Alert on this, not on single checks.
# TYPE watchfor_monitor_up gauge
watchfor_monitor_up{monitor_id="a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c51"} 1
watchfor_monitor_up{monitor_id="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d61"} 1
